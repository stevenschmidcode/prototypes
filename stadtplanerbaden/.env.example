# PostgreSQL connection string (docker-compose.yml starts a local instance on port 5433)
DATABASE_URL="postgresql://baden:baden_local_dev@localhost:5433/baden?schema=public"

# Optional: public base URL, used for absolute metadata URLs (e.g. https://baden.example.ch)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Datenbank für Integrationstests (Name muss «test» enthalten, wird automatisch angelegt)
# TEST_DATABASE_URL="postgresql://baden:baden_local_dev@localhost:5433/baden_test?schema=public"
